{
  "info": {
    "name": "TaskFlow API",
    "description": "TaskFlow — Görev ve Proje Yönetim Sistemi REST API test koleksiyonu.\n\nKullanım: Sunucuyu başlatın (npm start), koleksiyonu içe aktarın ve \"Run collection\" ile tüm testleri sırayla çalıştırın.\nbaseUrl değişkeni varsayılan olarak http://localhost:3000 adresini gösterir.\n\nNot: CRUD klasörü sırayla çalışmalıdır; \"Görev Ekle\" isteği oluşturulan görevin id'sini taskId değişkenine kaydeder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Yanıt JSON formatında\", () => {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});",
          "pm.test(\"Yanıt süresi 1 saniyenin altında\", () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(1000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Sistem",
      "description": "API bilgi endpoint'i.",
      "item": [
        {
          "name": "API Bilgisi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"API adı ve endpoint listesi dönüyor\", () => {",
                  "    const { data } = pm.response.json();",
                  "    pm.expect(data.name).to.eql(\"TaskFlow API\");",
                  "    pm.expect(data.endpoints).to.have.property(\"tasks\");",
                  "    pm.expect(data.endpoints).to.have.property(\"reports\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/"
          }
        }
      ]
    },
    {
      "name": "1 - Görev CRUD (Zorunlu)",
      "description": "Görev ekleme, listeleme, detay, güncelleme ve silme. Sırayla çalıştırılmalıdır.",
      "item": [
        {
          "name": "Görev Ekle",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const { success, data: task } = pm.response.json();",
                  "pm.test(\"Görev oluşturuldu ve id atandı\", () => {",
                  "    pm.expect(success).to.be.true;",
                  "    pm.expect(task.id).to.be.a(\"number\");",
                  "});",
                  "pm.test(\"Gönderilen alanlar kaydedildi\", () => {",
                  "    pm.expect(task.title).to.eql(\"Postman ile test görevi\");",
                  "    pm.expect(task.priority).to.eql(\"high\");",
                  "    pm.expect(task.assignee).to.eql(\"musa\");",
                  "    pm.expect(task.project).to.eql(\"TaskFlow API\");",
                  "});",
                  "pm.test(\"Varsayılan durum pending\", () => pm.expect(task.status).to.eql(\"pending\"));",
                  "pm.test(\"createdAt ve updatedAt oluşturuldu\", () => {",
                  "    pm.expect(task.createdAt).to.be.a(\"string\");",
                  "    pm.expect(task.updatedAt).to.eql(task.createdAt);",
                  "});",
                  "pm.collectionVariables.set(\"taskId\", task.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/tasks",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman ile test görevi\",\n  \"description\": \"Aşama 4 kapsamında Postman üzerinden oluşturuldu.\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\",\n  \"project\": \"TaskFlow API\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
