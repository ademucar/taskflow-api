                  "const body = pm.response.json();",
                  "pm.test(\"Görev listesi dizi olarak dönüyor\", () => {",
                  "    pm.expect(body.data).to.be.an(\"array\");",
                  "    pm.expect(body.count).to.eql(body.data.length);",
                  "});",
                  "pm.test(\"Yeni eklenen görev listede\", () => {",
